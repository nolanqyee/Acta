# acta-web environment — PUBLIC values only. Everything here ships in the client
# bundle, so it must NEVER contain the Supabase service role or any LLM key.
# Copy to `.env` for local dev (gitignored). Only VITE_-prefixed vars are exposed.

VITE_API_BASE_URL=http://localhost:8787

# Supabase browser client (publishable/anon key only — safe for the client).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
