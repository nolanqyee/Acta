# acta-web environment — PUBLIC values only. Everything here ships in the client
# bundle, so it must NEVER contain the Supabase service role or any LLM key.
# Copy to `.env` for local dev (gitignored). Only VITE_-prefixed vars are exposed.

VITE_API_BASE_URL=http://localhost:8787

# Supabase browser client (publishable/anon key only — safe for the client).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Static client header (defense-in-depth ONLY — NOT a secret, NOT a security
# boundary). Ships in the bundle; sent as X-Acta-Client so acta-api can shed
# obvious scraper traffic and rotate/kill a leaked value. Never gates data —
# per-user JWT + RLS do. See docs § Security Model & Threat Boundaries.
VITE_ACTA_CLIENT_KEY=15d1aa36-6409-495d-a6d4-3b0c6a7f0c3b

