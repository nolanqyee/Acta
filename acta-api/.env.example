# acta-api environment — BACKEND ONLY. Never copy these into acta-web / VITE_ vars.
# Copy to `.env` for local dev (gitignored).

# HTTP
PORT=8787

# Supabase (server-side). The service role key bypasses RLS — backend only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# JWT verification (prefer JWKS/asymmetric over a shared HS256 secret).
SUPABASE_JWKS_URL=

# LLM provider (pick one at U4). Backend only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS allowlist (acta-web origin), comma-separated.
WEB_ORIGIN=http://localhost:5173
